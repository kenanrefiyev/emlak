{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/app/*": ["./frontend/app/*"],
      "@/components/*": ["./frontend/components/*"],
      "@/i18n/*": ["./frontend/i18n/*"],
      "@/server/*": ["./backend/server/*"],
      "@/lib/*": ["./backend/lib/*"],
      "@/generated/*": ["./backend/generated/*"]
    }
  },
  "include": ["frontend/next-env.d.ts", "**/*.ts", "**/*.tsx", "frontend/.next/types/**/*.ts", "frontend/.next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
